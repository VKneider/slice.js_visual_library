{
  "name": "slicejs-components",
  "version": "2.0.0",
  "description": "Official Slice.js Components library and documentation registry for Visual and Service components",
  "main": "src/Components/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/VKneider/slicejs-components.git"
  },
  "homepage": "https://components.slicejs.com",
  "bugs": {
    "url": "https://github.com/VKneider/slicejs-components/issues"
  },
  "scripts": {
    "dev": "node ./node_modules/slicejs-cli/client.js dev --port 3001",
    "build": "node ./node_modules/slicejs-cli/client.js build",
    "start": "node ./node_modules/slicejs-cli/client.js start",
    "test": "node --import \"./scripts/register-path-resolve.js\" --test --test-concurrency=1 \"src/**/*.test.js\" \"parser/tests/**/*.test.js\"",
    "test:e2e": "playwright test --project=components",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:visual": "playwright test --project=visual",
    "test:e2e:visual:update": "playwright test --project=visual --update-snapshots",
    "check:teardown": "node scripts/check-teardown-hook.mjs",
    "test:gate": "pnpm run check:teardown && pnpm test && pnpm run icons:lint && pnpm run og:check && pnpm test:e2e && pnpm run build",
    "test:e2e:report": "playwright show-report",
    "slice:create": "node ./node_modules/slicejs-cli/client.js component create",
    "slice:list": "node ./node_modules/slicejs-cli/client.js component list",
    "slice:delete": "node ./node_modules/slicejs-cli/client.js component delete",
    "slice:init": "node ./node_modules/slicejs-cli/client.js init",
    "slice:version": "node ./node_modules/slicejs-cli/client.js version",
    "slice:update": "node ./node_modules/slicejs-cli/client.js update",
    "slice:get": "node ./node_modules/slicejs-cli/client.js get",
    "slice:browse": "node ./node_modules/slicejs-cli/client.js browse",
    "slice:sync": "node ./node_modules/slicejs-cli/client.js sync",
    "slice:build": "node ./node_modules/slicejs-cli/client.js build",
    "docs:generate": "node parser/index.js",
    "seo:generate": "node ./node_modules/slicejs-cli/client.js seo sitemap",
    "seo:check": "node ./node_modules/slicejs-cli/client.js seo check",
    "og:generate": "node scripts/og/generate.mjs",
    "og:check": "node scripts/og/generate.mjs --check",
    "docs:lint-md": "node parser/index.js --lint-only",
    "docs:sync-registry": "node parser/index.js --sync-only",
    "docs:agent": "node scripts/build-agent-catalog.mjs",
    "icons:generate": "node scripts/generate-icons.mjs && node scripts/generate-icon-table.mjs",
    "icons:audit": "node scripts/icon-map-audit.mjs && node scripts/icon-verify.mjs",
    "run": "node ./node_modules/slicejs-cli/client.js dev",
    "slice:dev": "slice dev",
    "slice:start": "slice start",
    "slice:types": "slice types generate",
    "slice:doctor": "node ./node_modules/slicejs-cli/client.js doctor",
    "slice:help": "node ./node_modules/slicejs-cli/client.js --help",
    "icons:lint": "node scripts/lint-icon-names.mjs",
    "lint": "slice lint",
    "lint:fix": "slice lint --fix"
  },
  "author": "vkneider",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "dompurify": "^3.4.16",
    "express": "^5.2.1",
    "gsap": "^3.15.0",
    "slicejs-cli": "^4.4.0",
    "slicejs-web-framework": "^4.1.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "dayjs": "^1.11.21",
    "lucide": "^1.55.0",
    "marked": "^18.0.5",
    "eslint": "^9.39.5"
  }
}
