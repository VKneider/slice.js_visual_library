{
    "server":  {
                   "port":  3001,
                   "host":  "localhost"
               },
    "debugger":  {
                     "enabled":  false,
                     "click":  "right"
                 },
    "events":  {
                   "enabled":  true,
                   "ui":  {
                              "enabled":  true,
                              "shortcut":  "alt+shift+e"
                          }
               },
    "context":  {
                    "enabled":  true,
                    "ui":  {
                               "enabled":  true,
                               "shortcut":  "alt+shift+c"
                           }
                },
    "stylesManager":  {
                          "requestedStyles":  [
                                                  "sliceStyles",
                                                  "DocumentationBase"
                                              ]
                      },
    "themeManager":  {
                         "enabled":  true,
                         "defaultTheme":  "LIGHT",
                         "saveThemeLocally":  false,
                         "useBrowserTheme":  false
                     },
    "logger":  {
                   "enabled":  true,
                   "showLogs":  {
                                    "console":  {
                                                    "error":  true,
                                                    "warning":  true,
                                                    "info":  true
                                                }
                                },
                   "ui":  {
                              "enabled":  false,
"shortcut": "ctrl+l"
                          }
               },
    "paths":  {
                  "components":  {
                                     "AppComponents":  {
                                                           "path":  "/Components/AppComponents",
                                                           "type":  "Visual"
                                                       },
                                     "Visual":  {
                                                    "path":  "/Components/Visual",
                                                    "type":  "Visual"
                                                },
                                     "Service":  {
                                                     "path":  "/Components/Service",
                                                     "type":  "Service"
                                                 },
                                     "DocumentationPages":  {
                                                                "path":  "/Components/DocumentationPages",
                                                                "type":  "Visual"
                                                            },
                                     "DemoComponents":  {
                                                            "path":  "/Components/DemoComponents",
                                                            "type":  "Visual"
                                                        }
                                 },
                  "themes":  "/Themes",
                  "styles":  "/Styles",
                  "markdownSource":  "/markdown",
                  "routesFile":  "/routes.js"
              },
    "router":  {
                   "defaultRoute":  "/"
               },
    "loading":  {
                    "enabled":  true
                },
    "publicFolders":  [
                          "/Themes",
                          "/Styles",
                          "/images",
                          "/markdown"
                      ]
}
